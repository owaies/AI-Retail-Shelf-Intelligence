# Frontend

VITE_API_BASE_URL=/api

# Backend

# PostgreSQL connection string. Keep the real value only in your local/host environment.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Optional Supabase project URL for future storage/auth integrations.
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Required when JWT authentication is introduced.
# JWT_SECRET_KEY=replace-with-a-long-random-secret
