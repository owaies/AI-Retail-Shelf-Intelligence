# Frontend
VITE_API_BASE_URL=/api
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Backend
# PostgreSQL/Supabase connection string. Keep the real value only in local/host environment.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SCHEMA=retail_shelf_intelligence
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Legacy local JWT fallback for isolated development/tests only.
# Production should use the Supabase Auth configuration above.
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ISSUER=retail-shelf-intelligence
JWT_ALGORITHM=HS256

# Local YOLOX ONNX inference
MODEL_URL=https://github.com/Megvii-BaseDetection/YOLOX/releases/download/0.1.1rc0/yolox_tiny.onnx
MODEL_PATH=.cache/models/yolox_tiny.onnx
MODEL_INPUT_SIZE=416
DETECTION_CONFIDENCE=0.25
NMS_IOU_THRESHOLD=0.45
